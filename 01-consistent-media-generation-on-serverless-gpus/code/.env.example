# Set these in your shell; never commit real tokens. Scripts do not auto-load .env.
BASE_URL=https://YOUR-ENDPOINT-HOST
TOKEN=YOUR-ENDPOINT-TOKEN
ENDPOINT_IMAGE=copy-exact-image-from-console
WORKER_IMAGE=your-registry/sana-worker@sha256:YOUR_DIGEST
BUCKET=your-existing-bucket
RUN_ID=your-unique-run-id
JOB_TIMEOUT=1h
