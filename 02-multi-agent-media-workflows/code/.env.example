# Module 2 settings. Notebooks and scripts read code/.env, ask for anything missing and save it
# here (mode 600, git-ignored). Never commit real values.
NEBIUS_API_KEY=your-token-factory-api-key

# 2.3, 2.5: the Sana Endpoint (template: sana)
SANA_BASE_URL=https://YOUR-SANA-ENDPOINT-HOST
SANA_TOKEN=YOUR-SANA-ENDPOINT-TOKEN
SANA_ENDPOINT_ID=YOUR-SANA-ENDPOINT-ID

# 2.4, 2.5: the Wan2.2 image-to-video Endpoint (template: wan22-i2v-a14b)
WAN22_I2V_BASE_URL=https://YOUR-WAN22-I2V-ENDPOINT-HOST
WAN22_I2V_TOKEN=YOUR-WAN22-I2V-ENDPOINT-TOKEN
WAN22_I2V_ENDPOINT_ID=YOUR-WAN22-I2V-ENDPOINT-ID

# Optional: also copy run assets to your bucket (AWS CLI credentials from Module 1)
BUCKET=
S3_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
